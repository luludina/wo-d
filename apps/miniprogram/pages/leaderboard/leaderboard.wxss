.leaderboard-screen {
  padding-top: 24rpx;
}

.period-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  height: 76rpx;
  padding: 6rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 14rpx;
  background: #edf2ef;
}

.period-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  border-radius: 10rpx;
  color: var(--color-muted);
  font-size: 25rpx;
}

.period-tab-active {
  background: #ffffff;
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(44, 76, 58, 0.08);
}

.range-text {
  min-height: 34rpx;
  margin: 16rpx 0 22rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  text-align: center;
}

.summary-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 24rpx 10rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 14rpx;
  background: #ffffff;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.summary-middle {
  border-right: 1rpx solid var(--color-border);
  border-left: 1rpx solid var(--color-border);
}

.summary-value {
  color: var(--color-primary);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
}

.summary-label {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  min-height: 320rpx;
  margin-top: 28rpx;
  padding: 20rpx 10rpx 0;
}

.podium-item {
  display: flex;
  flex: 0 1 31%;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 22rpx 10rpx 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 14rpx 14rpx 0 0;
  background: #ffffff;
}

.podium-position-1 {
  order: 2;
  min-height: 292rpx;
  border-color: #efd59d;
  background: #fffbf2;
}

.podium-position-2 {
  order: 1;
  min-height: 248rpx;
}

.podium-position-3 {
  order: 3;
  min-height: 222rpx;
}

.podium-medal {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}

.podium-medal image {
  width: 100%;
  height: 100%;
}

.podium-medal text {
  position: absolute;
  top: 8rpx;
  left: 0;
  width: 100%;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 600;
  text-align: center;
}

.podium-avatar,
.member-avatar {
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--color-primary-soft);
}

.podium-avatar {
  width: 82rpx;
  height: 82rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  font-weight: 600;
}

.podium-name {
  width: 100%;
  margin-top: 14rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-quantity {
  margin-top: 8rpx;
  color: var(--color-primary);
  font-size: 22rpx;
}

.zero-banner {
  margin-top: 28rpx;
  padding: 42rpx 24rpx;
  border: 1rpx dashed var(--color-border);
  border-radius: 14rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: center;
}

.ranking-section {
  margin-top: 30rpx;
}

.ranking-title {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.ranking-list {
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 14rpx;
  background: #ffffff;
}

.ranking-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  margin: 0 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.ranking-row:last-child {
  border-bottom: 0;
}

.ranking-row-me {
  margin: 0;
  padding: 0 24rpx;
  background: #eff7f2;
}

.rank-number {
  flex: 0 0 48rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.rank-number-1 { color: #b77710; }
.rank-number-2 { color: #707e76; }
.rank-number-3 { color: #a76034; }

.member-avatar {
  width: 64rpx;
  height: 64rpx;
  margin-left: 12rpx;
  font-size: 24rpx;
}

.member-name {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  margin-left: 18rpx;
  overflow: hidden;
  font-size: 25rpx;
}

.member-name > text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.me-badge {
  flex: 0 0 auto;
  margin-left: 10rpx;
  padding: 2rpx 9rpx;
  border-radius: 8rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 18rpx;
}

.member-quantity {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.member-quantity text {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
}

.state-block {
  padding: 130rpx 30rpx;
  color: var(--color-muted);
  text-align: center;
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #f8e8e5;
  color: var(--color-danger);
  font-size: 30rpx;
  font-weight: 600;
}

.empty-icon {
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 23rpx;
}

.state-title {
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 600;
}

.state-copy {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.retry-button {
  width: 220rpx;
  height: 72rpx;
  margin: 28rpx auto 0;
  border: 1rpx solid var(--color-border);
  border-radius: 10rpx;
  background: #ffffff;
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 72rpx;
}

.refreshing {
  position: fixed;
  top: 18rpx;
  left: 50%;
  z-index: 5;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background: rgba(32, 50, 41, 0.86);
  color: #ffffff;
  font-size: 19rpx;
  transform: translateX(-50%);
}
