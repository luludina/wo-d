.bills-screen {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-header {
  margin: 8rpx 4rpx 28rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}

.state-block,
.empty-state {
  padding: 96rpx 28rpx;
  color: var(--color-muted);
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 20rpx;
  border-radius: 12rpx;
  background: #eef2fa;
  color: #4c6594;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 12rpx;
  font-size: 23rpx;
}

.bill-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bill-card {
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface);
  box-shadow: 0 10rpx 30rpx rgba(38, 75, 54, 0.04);
}

.bill-card-hover {
  background: #f8faf9;
}

.bill-card-top,
.bill-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bill-period {
  font-size: 29rpx;
  font-weight: 600;
}

.bill-generated {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.adjusted-label {
  color: #946226;
}

.bill-arrow {
  width: 22rpx;
  height: 22rpx;
}

.bill-card-bottom {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.bill-amount-label {
  color: var(--color-muted);
  font-size: 23rpx;
}

.bill-amount {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 600;
}

.bill-currency {
  margin-right: 4rpx;
  font-size: 24rpx;
}
