.bill-detail-screen {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.state-block {
  padding: 96rpx 28rpx;
  color: var(--color-muted);
  text-align: center;
}

.state-error {
  color: var(--color-danger);
}

.summary-card {
  padding: 36rpx 30rpx;
  border: 1rpx solid #dce8e0;
  border-radius: 16rpx;
  background: #eaf3ed;
  text-align: center;
}

.summary-period {
  color: var(--color-muted);
  font-size: 23rpx;
}

.summary-label {
  margin-top: 28rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.summary-amount {
  margin-top: 6rpx;
  color: var(--color-primary);
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.2;
}

.summary-currency {
  margin-right: 6rpx;
  font-size: 30rpx;
}

.adjustment-notice {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #f0d7ae;
  border-radius: 12rpx;
  background: #fff8ec;
}

.adjustment-notice-title {
  color: #81551f;
  font-size: 25rpx;
  font-weight: 600;
}

.adjustment-notice-copy {
  margin-top: 8rpx;
  color: #8c714e;
  font-size: 22rpx;
  line-height: 1.55;
}
