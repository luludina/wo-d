<view class="screen bill-detail-screen">
  <view wx:if="{{loading}}" class="state-block">正在读取账单...</view>
  <view wx:elif="{{errorMessage}}" class="state-block state-error">{{errorMessage}}</view>
  <block wx:else>
    <view class="summary-card">
      <view class="summary-period">{{periodText}}</view>
      <view class="summary-label">本周合计</view>
      <view class="summary-amount"><text class="summary-currency">¥</text>{{amountText}}</view>
    </view>

    <view wx:if="{{isAdjusted}}" class="adjustment-notice">
      <view class="adjustment-notice-title">管理员已调整账单</view>
      <view class="adjustment-notice-copy">调整原因：{{adjustmentReason}}</view>
    </view>
  </block>
</view>
