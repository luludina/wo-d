<view class="screen bill-detail-screen">
  <view wx:if="{{loading}}" class="state-block">正在读取账单...</view>
  <view wx:elif="{{errorMessage}}" class="state-block state-error">{{errorMessage}}</view>
  <block wx:else>
    <view class="summary-card">
      <view class="summary-period">{{periodText}}</view>
      <view class="summary-label">本周合计</view>
      <view class="summary-amount"><text class="summary-currency">¥</text>{{amountText}}</view>
      <view class="summary-meta">{{totalQuantity}} 个鸡蛋 · ¥{{unitPriceText}} / 个</view>
    </view>

    <view class="detail-section">
      <view class="section-title">预约明细</view>
      <view class="detail-list">
        <view wx:for="{{items}}" wx:key="date" class="detail-row">
          <view class="detail-date">
            <text>{{item.dateText}}</text>
            <text class="detail-weekday">{{item.weekdayText}}</text>
          </view>
          <view class="detail-quantity">{{item.quantity}} 个</view>
        </view>
      </view>
    </view>
  </block>
</view>
