.reservation-screen {
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 26rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}

.settings-button,
.month-button,
.close-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  background: transparent;
  box-sizing: border-box;
}

.settings-button {
  min-width: 184rpx;
  height: 66rpx;
  padding: 0 20rpx;
  border: 1rpx solid #b8d4c3;
  border-radius: 12rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  gap: 10rpx;
}

.settings-button-icon {
  width: 27rpx;
  height: 27rpx;
}

.settings-button-hover {
  background: #d9eadf;
}

.calendar-card {
  padding: 22rpx 18rpx 24rpx;
}

.month-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.month-button {
  flex: 0 0 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 50%;
  background: #ffffff;
  color: var(--color-primary);
  overflow: visible;
}

.month-button-next {
  margin-left: auto;
}

.month-arrow {
  display: block;
  height: 58rpx;
  font-size: 46rpx;
  line-height: 52rpx;
}

.month-button-disabled {
  border-color: #edf1ee;
  background: #f7f9f8;
  color: #c4cec8;
}

.month-label {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.icon-button-hover:not(.month-button-disabled) {
  opacity: 0.72;
}

.weekday-grid,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.weekday-cell {
  height: 52rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 52rpx;
  text-align: center;
}

.weekday-cell.weekend {
  color: #a58b70;
}

.calendar-loading {
  height: 600rpx;
  color: var(--color-muted);
  line-height: 600rpx;
  text-align: center;
}

.calendar-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  height: 100rpx;
  padding-top: 10rpx;
  border-radius: 12rpx;
}

.day-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  font-size: 24rpx;
  line-height: 1;
}

.is-today .day-number {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

.is-selected:not(.is-today) .day-number {
  box-shadow: inset 0 0 0 2rpx var(--color-primary);
  color: var(--color-primary);
}

.relation-previous,
.relation-next {
  color: #c5cec8;
}

.cannot-navigate {
  color: #dce2de;
}

.cell-value {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 30rpx;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 19rpx;
  line-height: 1;
}

.reserved-value,
.zero-value {
  color: var(--color-primary);
  font-weight: 600;
  gap: 4rpx;
}

.mini-egg {
  display: inline-block;
  width: 18rpx;
  height: 23rpx;
  border: 2rpx solid #d49b46;
  border-radius: 50% 50% 45% 45% / 58% 58% 42% 42%;
  background: #fff8e9;
  box-sizing: border-box;
}

.state-closed,
.state-locked,
.state-unavailable,
.state-empty {
  color: #9aa69f;
}

.state-mark {
  color: #929f97;
  font-size: 18rpx;
}

.day-report {
  margin-top: 24rpx;
  padding: 0 26rpx;
  overflow: hidden;
}

.day-report-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--color-border);
  gap: 16rpx;
}

.day-report-title-row {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.day-report-action {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
}

.day-report-action-hover {
  opacity: 0.78;
}

.day-report-icon-shell {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  background: var(--color-primary-soft);
}

.day-report-icon {
  width: 27rpx;
  height: 27rpx;
}

.day-report-title {
  font-size: 27rpx;
  font-weight: 600;
}

.day-report-summary {
  margin-top: 5rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.day-report-state {
  padding: 52rpx 0;
  color: var(--color-muted);
  font-size: 23rpx;
  text-align: center;
}

.day-report-error {
  color: var(--color-danger);
}

.day-report-list {
  padding: 4rpx 0;
}

.day-report-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.day-report-row:last-child {
  border-bottom: 0;
}

.day-report-avatar {
  display: flex;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  overflow: hidden;
}

.day-report-avatar-fallback {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.day-report-name {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  overflow: hidden;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-report-quantity {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.day-report-quantity text {
  margin-right: 3rpx;
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.day-report-quantity-zero text {
  color: var(--color-muted);
}

.unsubmitted-section {
  padding-bottom: 4rpx;
  border-top: 1rpx solid var(--color-border);
}

.unsubmitted-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 78rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.unsubmitted-count {
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 400;
}

.unsubmitted-list {
  padding-top: 0;
}

.unsubmitted-empty {
  padding: 24rpx 0 34rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  text-align: center;
}

.unsubmitted-tag {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #f1f4f2;
  color: var(--color-muted);
  font-size: 20rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 6rpx 0;
  gap: 14rpx 22rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  color: var(--color-muted);
  font-size: 20rpx;
  gap: 7rpx;
}

.legend-symbol {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 22rpx;
  color: var(--color-primary);
  font-size: 18rpx;
  font-weight: 600;
}

.sheet-overlay {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(22, 35, 28, 0.34);
}

.bottom-sheet {
  width: 100%;
  padding: 18rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 20rpx 20rpx 0 0;
  background: #ffffff;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 4rpx;
  background: #d8e0db;
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
}

.sheet-status {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}

.close-button {
  width: 60rpx;
  height: 60rpx;
  color: var(--color-muted);
  font-size: 38rpx;
  line-height: 56rpx;
}

.quantity-editor {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 480rpx;
  margin: 42rpx auto 0;
  gap: 14rpx;
}

.editor-button,
.quantity-display {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  background: #ffffff;
  line-height: 1;
}

.editor-button {
  flex: 0 0 84rpx;
  width: 84rpx;
  color: var(--color-primary);
  font-size: 40rpx;
}

.quantity-display {
  flex: 0 1 220rpx;
  width: 220rpx;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
}

.quantity-options {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  margin-top: 18rpx;
  gap: 10rpx;
}

.quantity-option {
  height: 68rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 10rpx;
  background: #ffffff;
  color: var(--color-text);
  font-size: 25rpx;
  line-height: 66rpx;
}

.quantity-option-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 600;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 34rpx;
  line-height: 1;
}

.settings-sheet .submit-button {
  max-width: 480rpx;
  margin-right: auto;
  margin-left: auto;
}

.readonly-state {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f5f8f6;
  color: var(--color-muted);
  font-size: 24rpx;
  gap: 16rpx;
}

.readonly-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #e5ebe7;
  color: #748078;
  font-size: 20rpx;
  font-weight: 600;
}

.mode-selector {
  display: flex;
  margin-top: 34rpx;
  padding: 6rpx;
  border-radius: 12rpx;
  background: #edf1ee;
  gap: 6rpx;
}

.mode-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 9rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1;
  box-sizing: border-box;
}

.mode-button-active {
  background: #ffffff;
  color: var(--color-primary);
  font-weight: 600;
}

.batch-label {
  margin-top: 30rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  text-align: center;
}

.batch-quantity {
  line-height: 1;
}

.control-disabled {
  opacity: 0.45;
}

@media screen and (max-width: 360px) {
  .calendar-card {
    padding-right: 10rpx;
    padding-left: 10rpx;
  }

  .calendar-cell {
    height: 94rpx;
  }

  .quantity-options {
    gap: 6rpx;
  }
}
