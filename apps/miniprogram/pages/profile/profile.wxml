<view class="screen">
  <block wx:if="{{!isApplication && !editing}}">
    <view class="profile-card">
      <image wx:if="{{avatarUrl}}" class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="profile-avatar profile-avatar-empty">我</view>
      <view class="profile-summary-copy">
        <view class="profile-name-row">
          <view class="profile-summary-name">{{realName || nickname || '未填写姓名'}}</view>
          <view wx:if="{{isAdmin}}" class="profile-role">管理员</view>
        </view>
        <view class="profile-summary-meta">{{department || '未填写部门'}}</view>
        <view wx:if="{{nickname}}" class="profile-nickname">{{nickname}}</view>
      </view>
    </view>

    <view class="action-list">
      <view class="action-row" bindtap="startEditing" hover-class="action-row-hover" role="button" aria-label="修改资料">
        <view class="action-icon-shell">
          <image class="action-icon" src="/assets/icons/profile/edit.svg" mode="aspectFit" />
        </view>
        <view class="action-label">修改资料</view>
        <image class="action-arrow" src="/assets/icons/profile/right.svg" mode="aspectFit" />
      </view>
      <view wx:if="{{isAdmin}}" class="action-row" bindtap="openAdminBills" hover-class="action-row-hover" role="button" aria-label="账单汇总">
        <view class="action-icon-shell action-icon-shell-admin-bill">
          <image class="action-icon" src="/assets/icons/tabbar/calendar.svg" mode="aspectFit" />
        </view>
        <view class="action-label">账单汇总</view>
        <image class="action-arrow" src="/assets/icons/profile/right.svg" mode="aspectFit" />
      </view>
      <view class="action-row" bindtap="openBills" hover-class="action-row-hover" role="button" aria-label="我的账单">
        <view class="action-icon-shell action-icon-shell-bill">
          <image class="action-icon" src="/assets/icons/tabbar/calendar.svg" mode="aspectFit" />
        </view>
        <view class="action-label">我的账单</view>
        <image class="action-arrow" src="/assets/icons/profile/right.svg" mode="aspectFit" />
      </view>
      <view wx:if="{{isAdmin}}" class="action-row" bindtap="openMembers" hover-class="action-row-hover" role="button" aria-label="成员管理">
        <view class="action-icon-shell action-icon-shell-warm">
          <image class="action-icon" src="/assets/icons/profile/team.svg" mode="aspectFit" />
        </view>
        <view class="action-label">成员管理</view>
        <image class="action-arrow" src="/assets/icons/profile/right.svg" mode="aspectFit" />
      </view>
      <view class="action-row {{loggingOut ? 'action-row-disabled' : ''}}" bindtap="confirmLogout" hover-class="action-row-hover" role="button" aria-label="退出登录">
        <view class="action-icon-shell action-icon-shell-danger">
          <image class="action-icon" src="/assets/icons/profile/logout.svg" mode="aspectFit" />
        </view>
        <view class="action-label action-label-danger">{{loggingOut ? '正在退出...' : '退出登录'}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="compact-header">
      <view class="compact-title-row">
        <view wx:if="{{!isApplication}}" class="back-button" bindtap="cancelEditing" hover-class="back-button-hover" role="button" aria-label="返回我的页面">
          <image class="back-icon" src="/assets/icons/profile/left.svg" mode="aspectFit" />
        </view>
        <view class="page-title">{{isApplication ? '完善资料' : '修改资料'}}</view>
      </view>
      <view class="page-subtitle">姓名和部门用于管理员识别成员，手机号可选填。</view>
    </view>

    <view wx:if="{{rejectionReason}}" class="notice">{{rejectionReason}}</view>

    <view class="form card" wx:if="{{!loading}}">
      <view class="avatar-field">
        <view>
          <text class="label avatar-label">微信头像</text>
          <text class="field-hint">点击头像重新选择</text>
        </view>
        <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" loading="{{avatarUploading}}">
          <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-placeholder">选择</view>
        </button>
      </view>
      <label class="field">
        <text class="label">微信昵称</text>
        <input type="nickname" value="{{nickname}}" data-field="nickname" bindinput="updateField" placeholder="选择微信昵称" />
      </label>
      <label class="field">
        <text class="label">真实姓名 <text class="required">必填</text></text>
        <input value="{{realName}}" data-field="realName" bindinput="updateField" placeholder="请输入真实姓名" />
      </label>
      <label class="field">
        <text class="label">部门 <text class="required">必填</text></text>
        <input value="{{department}}" data-field="department" bindinput="updateField" placeholder="请输入所在部门" />
      </label>
      <label class="field field-last">
        <text class="label">手机号 <text class="optional">选填</text></text>
        <input type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="updateField" placeholder="请输入手机号" />
      </label>
      <view class="form-actions {{isApplication ? 'form-actions-single' : ''}}">
        <button wx:if="{{!isApplication}}" class="secondary-button form-action" disabled="{{saving}}" bindtap="cancelEditing">取消</button>
        <button class="primary-button form-action" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">
          {{isApplication ? '提交审核' : '保存'}}
        </button>
      </view>
    </view>
  </block>
</view>
